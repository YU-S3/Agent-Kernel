{
  "type": "object",
  "required": [
    "id",
    "version",
    "kernel_api",
    "loader",
    "exports"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kernel_api": {
      "const": 1
    },
    "loader": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "adapter",
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "const": "python"
            },
            "target": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "adapter",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "const": "jsonrpc_stdio"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "local_only": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "uniqueItems": true
      }
    },
    "requested_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "python_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "config_schema": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "optional_requires": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "uniqueItems": true
      }
    }
  }
}
