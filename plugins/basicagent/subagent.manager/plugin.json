{
  "id": "subagent.manager",
  "version": "1.0.0",
  "kernel_api": 1,
  "loader": {
    "adapter": "python",
    "target": "plugin:apply"
  },
  "exports": [
    "delegate",
    "status",
    "cancel"
  ],
  "requires": {
    "model": [
      "infer"
    ],
    "tools": [
      "list",
      "execute"
    ],
    "history": [
      "open",
      "append",
      "read"
    ],
    "context": [
      "build"
    ],
    "budget": [
      "reserve",
      "settle"
    ]
  },
  "config_schema": {
    "type": "object"
  },
  "python_dependencies": [
    "agentlab_plugins",
    "agentlab_app"
  ],
  "optional_requires": {
    "loop_policy": [
      "decide"
    ]
  }
}
