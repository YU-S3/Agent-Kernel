{
  "id": "tools.registry",
  "version": "1.1.0",
  "kernel_api": 1,
  "loader": {
    "adapter": "python",
    "target": "plugin:apply"
  },
  "exports": [
    "bootstrap",
    "register",
    "unregister",
    "list",
    "execute"
  ],
  "requires": {
    "policy": [
      "authorize"
    ]
  },
  "config_schema": {
    "type": "object"
  },
  "python_dependencies": [
    "agentlab_plugins",
    "agentlab_app"
  ],
  "optional_requires": {
    "file": [
      "describe",
      "execute"
    ],
    "shell": [
      "describe",
      "execute"
    ],
    "python": [
      "describe",
      "execute"
    ],
    "fixture": [
      "describe",
      "execute"
    ],
    "metadata": [
      "describe",
      "execute"
    ],
    "delegate": [
      "describe",
      "execute"
    ],
    "mcp": [
      "describe",
      "execute"
    ],
    "evidence": [
      "describe",
      "execute"
    ]
  }
}
